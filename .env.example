# ==========================================================================
# Prerna AI — environment variables
# Copy this file to .env (local dev) and fill in real values.
# NEVER commit a real .env file. All values here are placeholders.
# ==========================================================================

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
# Comma-separated list of admin emails auto-promoted to role=admin on signup (dev convenience only)
ADMIN_BOOTSTRAP_EMAILS=""

# --- Database (PostgreSQL, e.g. Supabase / Neon / Railway / local) --------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prerna_ai?schema=public"
# Supabase-style deployments: DATABASE_URL is the pooled (pgbouncer) connection
# used at runtime, DIRECT_URL is the unpooled connection `prisma migrate` needs.
# For a single local Postgres instance, set both to the same URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/prerna_ai?schema=public"

# --- Auth (Auth.js / NextAuth v5) ------------------------------------------
# Generate with: npx auth secret   (or `openssl rand -base64 32`)
AUTH_SECRET="replace-with-a-long-random-string"

# Optional Google sign-in (leave blank to disable the provider)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- OTP delivery (phone) ---------------------------------------------------
# Set OTP_PROVIDER=mock for local dev — codes are logged to the server console
# instead of being sent, and returned in the API response in non-production.
OTP_PROVIDER="mock" # "mock" | "twilio" | "msg91"
OTP_CODE_TTL_SECONDS="300"
OTP_MAX_ATTEMPTS="5"
OTP_REQUEST_COOLDOWN_SECONDS="45"

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""

# --- Email (magic link + transactional) -------------------------------------
EMAIL_PROVIDER="mock" # "mock" | "resend" | "smtp"
EMAIL_FROM="Prerna AI <no-reply@prernaai.com>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Mailbox that new support-ticket notifications are sent to (also used to
# reply to users). Delivery only actually happens once EMAIL_PROVIDER is a
# real provider, not "mock".
SUPPORT_INBOX_EMAIL="support@example.com"

# --- AI provider -------------------------------------------------------------
# AI_PROVIDER selects which adapter lib/ai/provider.ts uses at runtime.
AI_PROVIDER="mock" # "mock" | "anthropic" | "openai" | "gemini"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash" # gemini-2.5-flash was retired for new/billed keys — verify current model names via ListModels if this changes again
# Optional comma-separated fallback chain, tried in order only when
# GEMINI_MODEL's own quota is exhausted (a 429) — each model has its own
# separate RPM/RPD bucket, so this genuinely adds capacity rather than
# hiding the same limit. Leave blank to disable (fails immediately on 429
# like before). Check your own account's Rate Limit page for which models
# actually have free-tier quota before picking a chain.
GEMINI_FALLBACK_MODELS=""

# Per-user / per-IP rate limits and safety controls
AI_MAX_OUTPUT_TOKENS="2000"
AI_DAILY_MESSAGE_QUOTA_FREE="3"
AI_DAILY_MESSAGE_QUOTA_PAID="100"
AI_RATE_LIMIT_WINDOW_SECONDS="60"
AI_RATE_LIMIT_MAX_REQUESTS="8"

# --- Astrology calculation engine --------------------------------------------
# ASTROLOGY_PROVIDER=mock ships clearly-labeled demo data only in development.
# Point this at a real ephemeris/astrology API (e.g. ProKerala, AstrologyAPI,
# FreeAstrologyAPI, or a self-hosted Swiss Ephemeris service) for production.
ASTROLOGY_PROVIDER="mock" # "mock" | "prokerala" | "astrologyapi" | "custom"
ASTROLOGY_API_BASE_URL=""
ASTROLOGY_API_KEY=""
ASTROLOGY_API_SECRET=""

# Prokerala (ASTROLOGY_PROVIDER="prokerala") — OAuth2 client credentials from
# your app at https://api.prokerala.com/dashboard (Client ID / Client Secret,
# NOT the generic ASTROLOGY_API_KEY/SECRET above).
PROKERALA_CLIENT_ID=""
PROKERALA_CLIENT_SECRET=""

# --- Payments (Cashfree) ------------------------------------------------------
# PAYMENT_PROVIDER=mock enables a local, no-external-calls checkout for dev.
PAYMENT_PROVIDER="mock" # "mock" | "cashfree"
# Test (sandbox) keys from https://merchant.cashfree.com -> Developers -> API
# Keys, with Test Mode toggled on. CASHFREE_ENV=production + live keys for the
# real thing later.
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="sandbox" # "sandbox" | "production"
# Set on the same dashboard page under Webhooks -> Add Webhook, pointing at
# {NEXT_PUBLIC_APP_URL}/api/payments/webhook.
CASHFREE_WEBHOOK_SECRET=""

# Stripe reserved for future international expansion (architecture-only for now)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Rate limiting / abuse protection -----------------------------------------
# Optional: Upstash Redis for distributed rate limiting across serverless
# instances. Falls back to an in-memory limiter (single-instance only) if unset.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# CAPTCHA (Turnstile recommended — free, and the only one with a client
# widget wired up; see src/lib/captcha.ts). Protects /api/public/ask, the
# one AI endpoint anyone can call with no login. NEXT_PUBLIC_* copies exist
# because the site key (not the secret) has to reach the browser widget.
CAPTCHA_PROVIDER="none" # "none" | "turnstile" | "hcaptcha"
CAPTCHA_SITE_KEY=""
CAPTCHA_SECRET_KEY=""
NEXT_PUBLIC_CAPTCHA_PROVIDER=""
NEXT_PUBLIC_CAPTCHA_SITE_KEY=""

# --- Error tracking / observability -------------------------------------------
SENTRY_DSN=""
LOG_LEVEL="info" # "debug" | "info" | "warn" | "error"

# --- Ads (Google AdSense) -----------------------------------------------------
# Leave blank to disable ads entirely (default) — no script loads, no ad
# space reserved, nothing to configure. Fill both in once you have an
# AdSense account + one responsive display ad unit created in its
# dashboard: NEXT_PUBLIC_ADSENSE_CLIENT_ID is your publisher id ("ca-pub-…"),
# NEXT_PUBLIC_ADSENSE_SLOT_ID is that one ad unit's slot id — reused across
# every placement below, which is normal for a site just starting out with
# ads (create more units later only if you want to optimize per-placement).
# Ads never show on /dashboard, /chat, /kundli, or anywhere else behind
# login — only on the free public pages (blog, FAQ, panchang, daily
# horoscope) — and never to a signed-in Monthly Premium subscriber even
# there (see src/lib/payments/subscription-status.ts).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
NEXT_PUBLIC_ADSENSE_SLOT_ID=""

# --- Automation -----------------------------------------------------------------
# Shared secret for /api/cron/generate-horoscopes (auto-generates + auto-
# publishes daily horoscope content — see vercel.json for the schedule).
# Generate with: openssl rand -base64 32
CRON_SECRET=""
